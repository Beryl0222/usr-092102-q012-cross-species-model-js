      }
    },
    {
      "if": { "properties": { "event_type": { "const": "CLAIM_RECORDED" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "aggregate_type": { "const": "biological_claim" },
          "payload": { "$ref": "#/$defs/payload_claim_recorded" }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "CLAIM_VALIDATED" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "aggregate_type": { "const": "biological_claim" },
          "payload": { "$ref": "#/$defs/payload_claim_validated" }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "MODEL_CARD_PUBLISHED" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "aggregate_type": { "const": "model_card" },
          "payload": { "$ref": "#/$defs/payload_model_card_published" }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "FIGURE_PUBLISHED" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "aggregate_type": { "const": "figure" },
          "payload": { "$ref": "#/$defs/payload_figure_published" }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "ANNOTATION_UPGRADED" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "aggregate_type": { "enum": ["gene_vocabulary", "orthology_set"] },
          "payload": { "$ref": "#/$defs/payload_annotation_upgraded" }
        }
      }
    },
    {
      "if": { "properties": { "event_type": { "const": "SOURCE_WITHDRAWN" } }, "required": ["event_type"] },
      "then": {
        "properties": {
          "aggregate_type": { "const": "dataset_release" },
          "payload": { "$ref": "#/$defs/payload_source_withdrawn" }
        }
      }
    }
  ]
}
